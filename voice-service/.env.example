# ── ExcelPro Voice Service — Railway Config ──
# Copy this to .env on Railway (or set in Railway dashboard)

# Supabase (same as your Vercel env)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Anthropic (AI Receptionist)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ElevenLabs (Voice Synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Twilio (Validation + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1...
OWNER_PHONE_NUMBER=+1...

# Your Vercel site URL (for redirects back to main site)
SITE_URL=https://excelprowashers.com

# Port (Railway sets this automatically)
PORT=3001
