# ExcelPro Washers - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="ExcelPro Washers"

# Contact Information
OWNER_EMAIL=your@email.com
OWNER_PHONE_NUMBER=+1234567890

# Hot Lead Notifications
# Get these from your notification services

# Twilio SMS (required for instant SMS alerts)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Discord Webhook (optional - for team notifications)
# Get from: Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Resend Email Service (required for automated follow-ups)
# Get from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000/month
RESEND_API_KEY=re_your_resend_api_key

# Anthropic Claude API (required for AI lead qualification)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key

# Stripe Payment Processing (required for customer payments)
# Get from: https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_, sk_test_) for development
# Switch to live keys (pk_live_, sk_live_) for production
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Cron Job Security (required for automated follow-ups)
# Generate a random 32+ character string
# Example: openssl rand -base64 32
CRON_SECRET=generate_a_random_secret_here

# Database
# Currently using local JSON file (.local-db.json)
# For production, migrate to Vercel Postgres or Supabase

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
