# ExcelPro Washers - Environment Variables

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="ExcelPro Washers"

# Hot Lead Notifications
# Get these from your notification services

# Twilio SMS (optional - for instant SMS alerts)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# OWNER_PHONE_NUMBER=your_phone_number

# Discord Webhook (easiest to set up - recommended!)
# Get from: Server Settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# Email Notifications (optional)
# OWNER_EMAIL=your@email.com
# SENDGRID_API_KEY=your_sendgrid_key
# or
# RESEND_API_KEY=your_resend_key

# Database
# Currently using local JSON file (.local-db.json)
# For production, add PostgreSQL or MongoDB connection

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
