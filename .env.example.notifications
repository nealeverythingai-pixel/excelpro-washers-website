# AI Lead Qualification Notifications Configuration
# Copy this file to .env.local and configure with your credentials

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Email to receive lead notifications (required for email notifications)
NOTIFICATION_EMAIL=your-email@gmail.com

# Phone number for SMS alerts on hot leads (format: +16135551234)
NOTIFICATION_PHONE=+16135551234

# Your website URL (used in notification links)
NEXT_PUBLIC_SITE_URL=https://excelprowashers.com

# =============================================================================
# EMAIL SERVICE (Choose one provider)
# =============================================================================

# Option 1: Gmail (requires App Password - see setup guide below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# Option 3: Resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SMS SERVICE (Optional - for hot lead alerts)
# =============================================================================

# Twilio credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE=+16135551234

# =============================================================================
# SLACK INTEGRATION (Optional)
# =============================================================================

# Slack incoming webhook URL for lead notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# =============================================================================
# AI SERVICES (Already configured)
# =============================================================================

# Anthropic API for AI Lead Qualification
ANTHROPIC_API_KEY=your-anthropic-api-key

# ElevenLabs for voice AI
ELEVENLABS_API_KEY=your-elevenlabs-key

# =============================================================================
# SETUP GUIDES
# =============================================================================

# Gmail App Password Setup:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to "App passwords" (search for it)
# 4. Select "Mail" and "Other (Custom name)"
# 5. Enter "ExcelPro CRM" as the name
# 6. Copy the 16-character password (remove spaces)
# 7. Use this as SMTP_PASS

# SendGrid Setup:
# 1. Sign up at https://sendgrid.com/
# 2. Create an API key with "Mail Send" permissions
# 3. Verify your sender email address
# 4. Use the API key as SENDGRID_API_KEY

# Twilio SMS Setup:
# 1. Sign up at https://www.twilio.com/
# 2. Get a phone number
# 3. Find your Account SID and Auth Token in the console
# 4. Add these credentials above

# Slack Webhook Setup:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select existing
# 3. Enable "Incoming Webhooks"
# 4. Add webhook to your channel
# 5. Copy the webhook URL

# =============================================================================
# NOTIFICATION TYPES
# =============================================================================

# Console Logs: Always active - see terminal output
# Email: Requires NOTIFICATION_EMAIL + email service configured
# SMS: Requires NOTIFICATION_PHONE + Twilio configured (hot leads only)
# Slack: Requires SLACK_WEBHOOK_URL configured

# =============================================================================
# TESTING
# =============================================================================

# To test notifications:
# 1. Submit a test lead through your contact form
# 2. Check your terminal for console log output (always visible)
# 3. Check email inbox if email service is configured
# 4. Check Slack channel if webhook is configured
# 5. Hot leads will trigger SMS if Twilio is configured
